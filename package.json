{
  "name": "crypt",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "Plataforma social de comunidades, conversas, amizades e interesses.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "android:add": "npm run build && cap add android",
    "android:build:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:build:release": "npm run android:sync && cd android && gradlew.bat assembleRelease bundleRelease",
    "android:check": "npm run validate && cap doctor android",
    "android:open": "cap open android",
    "android:push:check": "node scripts/check-android-push-config.mjs",
    "android:run": "npm run android:sync && cap run android",
    "android:sync": "npm run build && cap sync android",
    "build": "tsc -b && vite build",
    "desktop:build": "npm run build && npm run desktop:compile && electron-builder --win nsis --publish never",
    "desktop:check": "npm run desktop:compile",
    "desktop:compile": "tsc -p tsconfig.electron.json",
    "desktop:dev": "npm run desktop:compile && concurrently --kill-others \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env CRYPT_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:info": "electron --version",
    "desktop:release": "npm run build && npm run desktop:compile && electron-builder --win nsis --publish always",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "security:check": "node scripts/security-audit.mjs",
    "supabase:db:push": "supabase db push",
    "supabase:functions:deploy": "supabase functions deploy delete-account --no-verify-jwt && supabase functions deploy livekit-token --no-verify-jwt && supabase functions deploy push-notifications --no-verify-jwt && supabase functions deploy external-oauth --no-verify-jwt",
    "supabase:link": "supabase link",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:test": "supabase test db",
    "supabase:types": "supabase gen types typescript --linked > src/types/database.generated.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "validate": "npm run typecheck && npm run lint && npm run security:check && npm run test && npm run format:check && npm run build",
    "validate:android": "npm run validate && npm run android:push:check && cap sync android",
    "validate:desktop": "npm run validate && npm run desktop:check"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@hookform/resolvers": "5.2.2",
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@supabase/supabase-js": "2.110.8",
    "@tanstack/react-query": "5.101.4",
    "electron-updater": "6.8.9",
    "livekit-client": "^2.21.0",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "42.6.0",
    "electron-builder": "26.15.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.kakasnowww.crypt",
    "productName": "Crypt",
    "artifactName": "Crypt-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src-tauri/icons/icon.ico",
        "to": "crypt.ico"
      }
    ],
    "protocols": [
      {
        "name": "Crypt",
        "schemes": [
          "crypt"
        ]
      }
    ],
    "win": {
      "executableName": "CryptMessenger",
      "icon": "src-tauri/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KakaSnowww",
        "repo": "crypt",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Crypt"
    }
  }
}
